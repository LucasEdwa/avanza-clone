# PostgreSQL
DATABASE_URL=postgres://localhost:5432/spira

# BankID: "simulator" (default, built-in phone simulator) or "test" (real BankID test environment)
BANKID_MODE=simulator
# Only for BANKID_MODE=test – public RP test certificate from bankid.com
BANKID_PFX_PATH=./certs/FPTestcert5_20240610.p12
BANKID_PFX_PASSPHRASE=qwerty123
BANKID_CA_PATH=./certs/bankid-test-ca.pem
BANKID_API_URL=https://appapi2.test.bankid.com/rp/v6.0

# Session inactivity timeout in minutes
SESSION_IDLE_MINUTES=30

# Protects /api/cron/tick when called externally
CRON_SECRET=change-me
AUTH_SECRET=generate-with-openssl-rand-hex-32
